{
  "name": "apod-ts",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "backend:build": "tsc -p tsconfig.json",
    "backend:start": "node dist/backend/server.js",
    "frontend:dev": "vite",
    "frontend:build": "vite build --emptyOutDir",
    "build": "npm run backend:build && npm run frontend:build",
    "dev": "concurrently \"npm run backend:start\" \"npm run frontend:dev\"",
    "build:dev": "npm run build && npm run dev"
  },
